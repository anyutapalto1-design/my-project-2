# Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Заполняется командой: python -m telegram_mcp.login
TELEGRAM_SESSION_STRING=

# true — только чтение: инструменты отправки, удаления и управления отключены
TELEGRAM_READ_ONLY=false

# Куда сохранять скачанные файлы (по умолчанию ~/Downloads/telegram-mcp)
# TELEGRAM_DOWNLOAD_DIR=

# Расшифровка голосовых: auto | telegram | whisper
TELEGRAM_TRANSCRIPTION=auto
# Модель faster-whisper для локальной расшифровки: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
